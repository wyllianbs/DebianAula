#! /bin/bash
### BEGIN INIT INFO
# Provides:          timezone
# Required-Start:
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: timezone
# Description: timezone
### END INIT INFO
case "$1" in
  start)
    echo "Starting timezone..."
    ln -sf /usr/share/zoneinfo/__TIMEZONE__ /etc/localtime
    timedatectl set-timezone __TIMEZONE__
    ;;
  stop)
    echo "Stopping timezone..."
    sleep 2
    ;;
  *)
    echo "Usage: /etc/init.d/timezone.sh {start|stop}"
    exit 1
    ;;
esac
exit 0
