{
  "policies": {
    "ExtensionSettings": {
      "uBlock0@raymondhill.net": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "installation_mode": "normal_installed"
      },
      "cookie-manager@robwu.nl": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/cookie-manager/latest.xpi",
        "installation_mode": "normal_installed"
      },
      "{ac40163c-8804-4dad-90fc-e25ebd6e9a57}": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/file/2408547/firefox_b-2.0.xpi",
        "installation_mode": "force_installed"
      }
    },
    "Homepage": {
      "URL": "https://moodle.ufsc.br",
      "StartPage": "homepage"
    },
    "DontCheckDefaultBrowser": true,
    "DownloadDirectory": "${home}/Downloads",
    "OfferToSaveLogins": false,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
